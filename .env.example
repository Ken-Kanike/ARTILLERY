# ==============================================================================
# Artilery — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
#
# Two modes:
#   ARTILERY_ENV=local       → Docker-based infra (default, no cloud needed)
#   ARTILERY_ENV=production  → Cloud services (Confluent, AWS, etc.)
# ==============================================================================

# Mode: 'local' (Docker) or 'production' (cloud)
ARTILERY_ENV=local

# ── Kafka ────────────────────────────────────────────────────────────────
# Local mode (default): Uses Docker Kafka on localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Production mode: Confluent Cloud credentials
# CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
# CONFLUENT_API_KEY=your-confluent-api-key
# CONFLUENT_API_SECRET=your-confluent-api-secret

# ── Neo4j ────────────────────────────────────────────────────────────────
# Local mode: Docker Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=artilery-local-password

# Production mode: Neo4j AuraDB
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-aura-password

# ── DynamoDB ─────────────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=artilery_state
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ── S3 / MinIO ──────────────────────────────────────────────────────────
S3_BUCKET_NAME=artilery-event-logs
S3_ENDPOINT_URL=http://localhost:9000

# ── AWS Credentials ─────────────────────────────────────────────────────
# Local mode: MinIO credentials (used for S3 and DynamoDB)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Production mode: Real AWS credentials
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=us-east-1

# ── LLM ─────────────────────────────────────────────────────────────────
# Local mode: Ollama (install from https://ollama.com, then: ollama pull llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Production mode: AWS Bedrock
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── Slack (optional) ────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# DEFAULT_SLACK_CHANNEL=C0123456789

# ── Jira (optional) ─────────────────────────────────────────────────────
# JIRA_URL=https://your-org.atlassian.net
# JIRA_USERNAME=your-email@company.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=ART

# ── Notion (optional) ───────────────────────────────────────────────────
# NOTION_TOKEN=ntn_xxxxx
# NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── GitHub ───────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=local-dev-secret
